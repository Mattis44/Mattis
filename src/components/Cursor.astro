---
---

<div id="cursor-dot"></div>
<div id="cursor-ring"></div>

<style>
  #cursor-dot,
  #cursor-ring {
    position: fixed;
    top: 0;
    left: 0;
    border-radius: 50%;
    pointer-events: none;
    z-index: 99999;
    translate: -50% -50%;
    opacity: 0;
    will-change: transform;
  }

  #cursor-dot {
    width: 6px;
    height: 6px;
    background: #fff;
  }

  #cursor-ring {
    width: 32px;
    height: 32px;
    background: white;
    mix-blend-mode: difference;
    transition: width 0.25s ease, height 0.25s ease, border-radius 0.25s ease;
  }

  #cursor-ring.is-hovering {
    width: 52px;
    height: 52px;
  }

  #cursor-ring.is-text {
    width: 2px;
    height: 22px;
    border-radius: 2px;
  }

  #cursor-dot.is-clicking {
    transform: scale(0.5);
  }
</style>

<script>
  import { gsap } from 'gsap';

  const dot  = document.getElementById('cursor-dot')!;
  const ring = document.getElementById('cursor-ring')!;

  const dotX  = gsap.quickTo(dot,  'x', { duration: 0.1 });
  const dotY  = gsap.quickTo(dot,  'y', { duration: 0.1 });
  const ringX = gsap.quickTo(ring, 'x', { duration: 0.5, ease: 'power3' });
  const ringY = gsap.quickTo(ring, 'y', { duration: 0.5, ease: 'power3' });

  let visible = false;
  const show = () => {
    if (visible) return;
    visible = true;
    gsap.to([dot, ring], { opacity: 1, duration: 0.3 });
  };

  const MAGNETIC_ZONE = 70;
  const magneticEls = () => document.querySelectorAll<HTMLElement>('[data-magnetic]');
  const magneticActive = new Set<HTMLElement>();

  window.addEventListener('mousemove', (e) => {
    show();

    let pulled = false;

    magneticEls().forEach((el) => {
      const rect = el.getBoundingClientRect();
      const cx   = rect.left + rect.width  / 2;
      const cy   = rect.top  + rect.height / 2;
      const dx   = e.clientX - cx;
      const dy   = e.clientY - cy;
      const dist = Math.sqrt(dx * dx + dy * dy);

      if (dist < MAGNETIC_ZONE) {
        pulled = true;
        magneticActive.add(el);
        const pull = 1 - dist / MAGNETIC_ZONE;

        ringX(cx + dx * (1 - pull * 0.75));
        ringY(cy + dy * (1 - pull * 0.75));

        gsap.to(el, {
          x: dx * 0.3 * pull,
          y: dy * 0.3 * pull,
          duration: 0.3,
          ease: 'power2.out',
          overwrite: 'auto',
        });
      } else if (magneticActive.has(el)) {
        magneticActive.delete(el);
        gsap.to(el, {
          x: 0, y: 0,
          duration: 0.6,
          ease: 'elastic.out(1, 0.4)',
          overwrite: 'auto',
        });
      }
    });

    dotX(e.clientX);
    dotY(e.clientY);
    if (!pulled) {
      ringX(e.clientX);
      ringY(e.clientY);
    }
  });

  window.addEventListener('mouseleave', () => {
    gsap.to([dot, ring], { opacity: 0, duration: 0.3 });
    visible = false;
  });

  const interactives = 'a, button, [data-cursor-hover]';
  const textEls = 'p, h1, h2, h3, h4, h5, h6, li, blockquote, label, span, [data-cursor-text]';

  document.addEventListener('mouseover', (e) => {
    const t = e.target as Element;
    if (t.closest(interactives)) {
      ring.classList.add('is-hovering');
      ring.classList.remove('is-text');
      gsap.to(dot, { autoAlpha: 0, duration: 0.2 });
    } else if (t.closest(textEls)) {
      ring.classList.add('is-text');
      ring.classList.remove('is-hovering');
      gsap.to(dot, { autoAlpha: 0, duration: 0.2 });
    }
  });

  document.addEventListener('mouseout', (e) => {
    const t = e.target as Element;
    const to = (e as MouseEvent).relatedTarget as Element | null;

    if (t.closest(interactives) && !to?.closest(interactives)) {
      ring.classList.remove('is-hovering');
      if (!to?.closest(textEls)) gsap.to(dot, { autoAlpha: 1, duration: 0.2 });
    }
    if (t.closest(textEls) && !to?.closest(textEls)) {
      ring.classList.remove('is-text');
      if (!to?.closest(interactives)) gsap.to(dot, { autoAlpha: 1, duration: 0.2 });
    }
  });

  window.addEventListener('mousedown', () => dot.classList.add('is-clicking'));
  window.addEventListener('mouseup',   () => dot.classList.remove('is-clicking'));
</script>
