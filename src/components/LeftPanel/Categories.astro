---
import type { SvgComponent } from "astro/types";

type Props = {
    categories: {
        name: string;
        icon: SvgComponent;
        href?: string;
    }[];
    title: string;
    navIndicator?: boolean;
};
const { categories, title, navIndicator = false } = Astro.props as Props;
---

<div class="flex flex-col gap-1">
    <div class="cursor-pointer">
        <p
            class="text-(--category-title-color) hover:text-white transition-colors flex items-center gap-3 font-bold text-lg"
        >
            {title}
        </p>
    </div>
    <div class="flex flex-col ml-2 relative" id={navIndicator ? "nav-links" : undefined}>
        {navIndicator && (
            <div
                id="nav-indicator"
                class="absolute pointer-events-none rounded-full opacity-0"
                style="left: -6px; width: 2px; top: 0; height: 32px; background: white; box-shadow: 0 0 6px rgba(255,255,255,0.6);"
            />
        )}
        {
            categories.map((category) => (
                <a
                    class="group cursor-pointer flex flex-row gap-4 items-center p-3 rounded-md
         hover:glass-card hover:bg-white/10 hover:border-white/20 hover:backdrop-blur-md transition-colors"
                    href={category.href ?? `#${category.name.toLowerCase()}`}
                    data-nav-link={navIndicator ? category.name.toLowerCase() : undefined}
                >
                    <div class="w-6 h-6 flex items-center justify-center">
                        <category.icon />
                    </div>
                    <p class="text-(--category-item-color) group-hover:text-white flex items-center gap-3 font-medium transition-colors">
                        {category.name}
                    </p>
                </a>
            ))
        }
    </div>
</div>

<style>
    [data-nav-link].is-nav-active p {
        color: white;
    }
</style>
